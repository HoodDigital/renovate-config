{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Hood Digital shared Renovate preset. Extend it with github>HoodDigital/renovate-config.",
    "Repo-specific groups, schedules and PR bodies stay in each repo."
  ],
  "extends": ["config:recommended", "docker:pinDigests"],
  "dependencyDashboard": true,
  "configMigration": true,
  "semanticCommits": "disabled",
  "commitMessageTopic": "{{depName}}",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "major": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0
  },
  "packageRules": [
    {
      "description": "Image tags and digests carry no release date, so the soak would hold every Docker update forever.",
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "Docker image pins",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pinDigest"]
    },
    {
      "groupName": "Docker image digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["before 9am on monday"]
    },
    {
      "description": "One PR for every NuGet minor and patch update, so a private repo pays for one build instead of one per package. The .NET SDK in global.json is the dotnet-version datasource, so it keeps its own PR.",
      "groupName": "NuGet packages",
      "matchDatasources": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "These packages must move in the same PR, because a new one beside an old one throws a TypeLoadException.",
      "groupName": "Auth0",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["Auth0.Core", "Auth0.AuthenticationApi", "Auth0.ManagementApi"],
      "separateMajorMinor": false,
      "minimumReleaseAge": null
    }
  ]
}
